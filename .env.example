# Written by `npx convex dev`. Copy to .env.local if you configure it by hand.
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud
# Development only: shows a "test game length" field on Create room.
# The Convex deployment must also have ALLOW_TEST_ROOMS=true (npx convex env set ALLOW_TEST_ROOMS true).
EXPO_PUBLIC_ENABLE_TEST_ROOMS=false
